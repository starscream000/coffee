{
  "title": "event.recordingStopped (protocol 0.1.1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recordingId": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "stopped",
        "browserClosed"
      ]
    },
    "steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "recordingId",
    "file",
    "reason",
    "steps"
  ],
  "additionalProperties": {}
}
