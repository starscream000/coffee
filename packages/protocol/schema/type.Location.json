{
  "title": "type.Location (protocol 0.1.1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Location",
  "$defs": {
    "Location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "file",
        "line",
        "column"
      ],
      "additionalProperties": {}
    }
  }
}
