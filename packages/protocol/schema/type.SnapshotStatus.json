{
  "title": "type.SnapshotStatus (protocol 0.1.1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SnapshotStatus",
  "$defs": {
    "SnapshotStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "saved"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "skipped"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "failed"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": {}
        }
      ]
    }
  }
}
