<!--
  One look for every kind of control, built from the design tokens (ADR D0008):
  the window and its panels, text, the four kinds of button (normal, main,
  quiet, danger), inputs, lists, trees, tabs, cards, badges and splitters.
  Every control shows keyboard focus. Views pick a look with Classes and never
  set colours, sizes or spacing of their own.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The window -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock, SelectableTextBlock">
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small, TextBlock.label, SelectableTextBlock.small">
    <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource TextTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.page">
    <Setter Property="FontSize" Value="{StaticResource TextPage}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.code, SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
  </Style>
  <Style Selector="TextBlock.failed, SelectableTextBlock.failed">
    <Setter Property="Foreground" Value="{StaticResource FailedBrush}" />
  </Style>
  <Style Selector="TextBlock.warning, SelectableTextBlock.warning">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.passed">
    <Setter Property="Foreground" Value="{StaticResource PassedBrush}" />
  </Style>
  <Style Selector="TextBlock.glyph">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Width" Value="{StaticResource GlyphWidth}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Regions: a panel's body, its header strip, notices, cards, badges -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
  </Style>
  <!-- A region of the window (project, tabs, details, bottom): a panel with a line around it, on the window tone -->
  <Style Selector="Border.region">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineAll}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.panelHeader">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineBottom}" />
    <Setter Property="Padding" Value="{StaticResource InsetX3Y2}" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineBottom}" />
    <Setter Property="Padding" Value="{StaticResource InsetX3Y2}" />
  </Style>
  <Style Selector="Border.statusBar">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineTop}" />
    <Setter Property="Padding" Value="{StaticResource InsetX3Y1}" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineBottom}" />
    <Setter Property="Padding" Value="{StaticResource InsetX3Y2}" />
  </Style>
  <Style Selector="Border.notice.failed">
    <Setter Property="Background" Value="{StaticResource FailedSubtleBrush}" />
  </Style>
  <Style Selector="Border.notice.warning">
    <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineAll}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Padding" Value="{StaticResource Inset3}" />
  </Style>
  <Style Selector="Border.card.selected">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Border.card.failure">
    <Setter Property="BorderBrush" Value="{StaticResource FailedBrush}" />
    <Setter Property="Background" Value="{StaticResource FailedSubtleBrush}" />
  </Style>
  <Style Selector="Border.card.step">
    <Setter Property="Padding" Value="{StaticResource Inset0}" />
  </Style>
  <Style Selector="Border.card.muted">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineAll}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Padding" Value="{StaticResource Inset6}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="{StaticResource InsetX2}" />
    <Setter Property="Margin" Value="{StaticResource InsetLeft1}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Border.badge.error">
    <Setter Property="Background" Value="{StaticResource FailedBrush}" />
  </Style>
  <Style Selector="Border.badge.warning">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="Border.badge.error > TextBlock, Border.badge.warning > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WindowBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Marks -->
  <Style Selector="Ellipse.status">
    <Setter Property="Width" Value="{StaticResource StatusSize}" />
    <Setter Property="Height" Value="{StaticResource StatusSize}" />
    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="Ellipse.status.ready">
    <Setter Property="Fill" Value="{StaticResource PassedBrush}" />
  </Style>
  <Style Selector="Ellipse.status.busy">
    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Ellipse.status.failed">
    <Setter Property="Fill" Value="{StaticResource FailedBrush}" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="{StaticResource DotSize}" />
    <Setter Property="Height" Value="{StaticResource DotSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.dot.failed">
    <Setter Property="Fill" Value="{StaticResource FailedBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.warning">
    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Ellipse.dot.passed">
    <Setter Property="Fill" Value="{StaticResource PassedBrush}" />
  </Style>

  <!-- Buttons: normal (the default), main, quiet and danger -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineAll}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="Padding" Value="{StaticResource InsetX3Y1}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PressedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- main: filled with the accent; at most one per region -->
  <Style Selector="Button.main">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.main:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.main:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.main:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.main:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentSubtleBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <!-- quiet: for toolbars, list rows and tab buttons; no fill until hovered -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="{StaticResource NoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoBrush}" />
    <Setter Property="Padding" Value="{StaticResource InsetX2Y1}" />
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource NoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoBrush}" />
  </Style>
  <Style Selector="Button.quiet:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- danger: Delete, Remove; set apart, and asks before it destroys work -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource NoBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FailedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FailedBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FailedSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FailedHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FailedHoverBrush}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FailedSubtleBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FailedBrush}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource NoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
  </Style>
  <Style Selector="Button.danger:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- A row of a list made of buttons (steps, actions, runs): quiet, full width, marked when selected -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="{StaticResource NoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="{StaticResource InsetX2Y1}" />
  </Style>
  <Style Selector="Button.row.selected">
    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="Button.row.skipped">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Inputs: one look, a raised field with a line, the accent when focused -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineAll}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover, TextBox:focus">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="{StaticResource TextLabel}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineAll}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
  </Style>

  <!-- Lists and trees: selection in the accent's subtle tone -->
  <Style Selector="ListBox, TreeView">
    <Setter Property="Background" Value="{StaticResource NoBrush}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{StaticResource InsetX2Y1}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
  </Style>
  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
  </Style>

  <!-- Tabs: the selected one raised and underlined in the accent -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{StaticResource TextBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="Padding" Value="{StaticResource InsetX3Y1}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TabItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>

  <!--
    Tab switches (the views of a file, the parts of the bottom panel): not a
    fifth kind of button but tabs, muted text with the accent under the one shown
  -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="{StaticResource NoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource NoBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineAccent}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="Padding" Value="{StaticResource InsetX3Y1}" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Splitters: the window tone between regions, the accent when the pointer is on it -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
  </Style>
</Styles>
