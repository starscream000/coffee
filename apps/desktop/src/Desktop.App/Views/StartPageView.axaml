<!-- The start page: open a project folder or a recent project; the engine's state. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             x:Class="Desktop.App.Views.StartPageView"
             x:DataType="vm:ShellViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="{StaticResource PageWidth}" Margin="{StaticResource InsetPage}" Spacing="{StaticResource Space6}" HorizontalAlignment="Center">
      <StackPanel Spacing="{StaticResource Space1}">
        <TextBlock Text="{Binding ProductName}" Classes="page" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Browse, check and manage the end-to-end tests of a project. Open the folder that holds its config file." />
      </StackPanel>
      <Button x:Name="OpenFolderButton" Content="Open a project folder…" Command="{Binding OpenFolderCommand}" Classes="main" />

      <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding HasRecentProjects}">
        <TextBlock Classes="title" Text="Recent projects" />
        <ItemsControl ItemsSource="{Binding RecentProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentProjectViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource InsetBottom1}">
                <Button Grid.Column="0" Classes="row" IsEnabled="{Binding Exists}"
                        Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenRecentCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Classes="strong" />
                    <TextBlock Text="{Binding Path}" Classes="label" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Content="Forget" Classes="quiet" Margin="{StaticResource InsetLeft1}" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).ForgetRecentCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="{StaticResource Space2}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <Ellipse Classes="status" Classes.ready="{Binding Engine.IsReady}" Classes.busy="{Binding Engine.IsBusy}" Classes.failed="{Binding Engine.IsFailed}" />
            <TextBlock Classes="heading" Text="{Binding Engine.StateText}" />
          </StackPanel>
          <SelectableTextBlock Text="{Binding Engine.Detail}" TextWrapping="Wrap" Classes="muted" />
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" IsVisible="{Binding Engine.IsFailed}">
            <Button Content="Try again" Command="{Binding RestartEngineCommand}" />
            <Button Content="Settings" Command="{Binding ToggleSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
