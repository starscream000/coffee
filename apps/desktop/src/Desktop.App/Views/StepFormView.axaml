<!-- The form of the selected step: its action, a field per parameter and setting with the engine's problems next to them, a call step's flow parameters, and the step's other problems. Text fields write back when they lose focus. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:steps="using:Desktop.App.ViewModels.Steps"
             x:Class="Desktop.App.Views.StepFormView"
             x:DataType="steps:StepFormViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="steps:StepFieldViewModel">
      <StackPanel Spacing="{StaticResource Space1}">
        <TextBlock Text="{Binding Label}" Classes="label strong" />
        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding IsLine}" />
        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
        <AutoCompleteBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding TargetNames}" FilterMode="ContainsOrdinal"
                         IsVisible="{Binding IsTarget}" PlaceholderText="A target name" />
        <TextBox Classes="code" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding IsYaml}" AcceptsReturn="True" TextWrapping="NoWrap"
                 MinHeight="{StaticResource CodeMinHeight}" />
        <TextBlock Text="{Binding Note}" Classes="label" TextWrapping="Wrap" IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding Description}" Classes="label" TextWrapping="Wrap" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding Error}" Classes="small failed" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding Problem}" Classes="small failed" TextWrapping="Wrap"
                   IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <ScrollViewer>
    <StackPanel Margin="{StaticResource Inset3}" Spacing="{StaticResource Space2}">
      <TextBlock x:Name="FormAction" Text="{Binding Action}" Classes="code title" />
      <TextBlock Text="{Binding Description}" Classes="label" TextWrapping="Wrap" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Classes="warning" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" Classes="small failed" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl x:Name="FormParameters" ItemsSource="{Binding Parameters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{StaticResource Space3}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Text="{Binding FlowNote}" Classes="label" TextWrapping="Wrap" IsVisible="{Binding FlowNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding HasFlowParameters}">
        <TextBlock Text="with: the flow's parameters" Classes="section" Margin="{StaticResource InsetTop2}" />
        <ItemsControl x:Name="FlowParameters" ItemsSource="{Binding FlowParameters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{StaticResource Space3}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <TextBlock Text="Step" Classes="section" Margin="{StaticResource InsetTop2}" />
      <ItemsControl x:Name="FormSettings" ItemsSource="{Binding Settings}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{StaticResource Space3}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
