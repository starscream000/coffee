<!-- The action catalogue: a searchable list on the left, the selected action's details on the right. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             x:Class="Desktop.App.Views.ActionCatalogView"
             x:DataType="vm:ActionCatalogViewModel">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource ColumnSide}" />
      <ColumnDefinition Width="{StaticResource SplitterLength}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Inset2}" Spacing="{StaticResource Space1}">
        <TextBox Text="{Binding SearchText}" PlaceholderText="Search actions" />
        <TextBlock Text="{Binding Summary}" Classes="label" />
      </StackPanel>
      <ListBox x:Name="ActionList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ActionItemViewModel">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Classes="code strong" />
                <Border Classes="badge" IsVisible="{Binding IsUserAction}">
                  <TextBlock Classes="small" Text="user" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Description}" Classes="label" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <ScrollViewer Grid.Column="2">
      <StackPanel Margin="{StaticResource Inset4}" Spacing="{StaticResource Space2}" DataContext="{Binding Selected}" x:DataType="vm:ActionItemViewModel"
                  IsVisible="{Binding $parent[UserControl].((vm:ActionCatalogViewModel)DataContext).Selected, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
        <TextBlock Text="{Binding Name}" Classes="code page" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SourceText, StringFormat='Defined: {0}'}" Classes="label" />
        <TextBlock Text="{Binding ShorthandText}" Classes="small" TextWrapping="Wrap" />
        <TextBlock Classes="title" Text="Parameters" Margin="{StaticResource InsetTop2}" />
        <TextBlock Text="This action takes no parameters, or its schema does not list them." Classes="label" IsVisible="{Binding !HasParameters}" />
        <ItemsControl ItemsSource="{Binding Parameters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ActionParameterViewModel">
              <Grid Margin="{StaticResource InsetY1}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{StaticResource ColumnName}" />
                  <ColumnDefinition Width="{StaticResource ColumnType}" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space1}">
                  <TextBlock Text="{Binding Name}" Classes="code" />
                  <TextBlock Text="required" Classes="small failed" IsVisible="{Binding IsRequired}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Type}" Classes="code label" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="small" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander Header="Parameter schema (JSON)" HorizontalAlignment="Stretch">
          <SelectableTextBlock Text="{Binding SchemaText}" Classes="code small" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
