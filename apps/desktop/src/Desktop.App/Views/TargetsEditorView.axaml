<!--
  The targets view of a file: its targets by name, and adding a target. The
  selected target's frame, within and candidates are edited in the details
  panel (TargetFormView; instruction D0004, task 9).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:targets="using:Desktop.App.ViewModels.Targets"
             x:Class="Desktop.App.Views.TargetsEditorView"
             x:DataType="targets:TargetsEditorViewModel">
  <DockPanel>
    <TextBlock x:Name="TargetsProblem" DockPanel.Dock="Top" Margin="{StaticResource Inset3}" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding !IsAvailable}" />

    <DockPanel IsVisible="{Binding IsAvailable}">
      <StackPanel DockPanel.Dock="Top" Margin="{StaticResource InsetX3Y2}" Spacing="{StaticResource Space1}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Add target" Command="{Binding AddTargetCommand}" Margin="{StaticResource InsetLeft1}" />
          <TextBox x:Name="NewTargetName" Text="{Binding NewName}" PlaceholderText="New target name, such as cart.checkout" />
        </DockPanel>
        <TextBlock Text="{Binding Notice}" Classes="small failed" TextWrapping="Wrap"
                   IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding EmptyText}" Classes="label" IsVisible="{Binding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <ListBox x:Name="TargetNames" Margin="{StaticResource InsetX2}" ItemsSource="{Binding Names}" SelectedItem="{Binding SelectedName}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" Classes="code" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
