<!-- An editable step file: toolbar, bars for changes on disk and failed saves, and the editor with problem lines marked. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="Desktop.App.Views.StepFileView"
             x:DataType="vm:StepFileViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panelHeader" Padding="10,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding ProblemSummary}" Classes="small" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="Undo" Command="{Binding UndoCommand}" Padding="8,2" />
          <Button Content="Redo" Command="{Binding RedoCommand}" Padding="8,2" />
          <Button Content="Revert" Command="{Binding RevertCommand}" Padding="8,2" ToolTip.Tip="Put back the file as last read or saved" />
          <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" Padding="8,2" Classes="accent" />
        </StackPanel>
        <TextBlock Text="{Binding File}" Classes="code small" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" IsVisible="{Binding HasExternalChange}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="Reload from disk" Command="{Binding ReloadFromDiskCommand}" />
          <Button Content="Keep my version" Command="{Binding KeepMineCommand}" />
        </StackPanel>
        <TextBlock x:Name="ExternalChangeText" Text="The file changed on disk while you were editing it." VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" IsVisible="{Binding IsDeletedOnDisk}">
      <TextBlock Text="The file was deleted on disk. Save to create it again." TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Padding="10,6" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding SaveError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
    </Border>
    <TextBlock DockPanel.Dock="Top" Margin="12" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
               IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <edit:TextEditor x:Name="Editor"
                     Document="{Binding Document}"
                     ShowLineNumbers="True"
                     FontFamily="{StaticResource CodeFont}"
                     FontSize="13"
                     Padding="4,2"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</UserControl>
