<!-- A step file, read-only, with line numbers and problem lines marked. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             x:Class="Desktop.App.Views.StepFileView"
             x:DataType="vm:StepFileViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Grid.line.error">
      <Setter Property="Background" Value="{StaticResource ErrorLineBrush}" />
    </Style>
    <Style Selector="Grid.line.warning">
      <Setter Property="Background" Value="{StaticResource WarningLineBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panelHeader">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ProblemSummary}" Classes="small" Foreground="{StaticResource ErrorBrush}" />
        <TextBlock Text="{Binding File}" Classes="code small" />
      </DockPanel>
    </Border>
    <TextBlock DockPanel.Dock="Top" Margin="12" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
               IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <ListBox x:Name="LineList" ItemsSource="{Binding Lines}" SelectedItem="{Binding RevealedLine}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:StepFileLineViewModel">
          <Grid Classes="line" Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}"
                ColumnDefinitions="4,52,*" ToolTip.Tip="{Binding Messages}">
            <Rectangle Grid.Column="0" Fill="{StaticResource ErrorBrush}" IsVisible="{Binding IsError}" />
            <Rectangle Grid.Column="0" Fill="{StaticResource WarningBrush}" IsVisible="{Binding IsWarning}" />
            <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="code muted" TextAlignment="Right" Margin="0,1,12,1" />
            <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="code" Margin="0,1" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
