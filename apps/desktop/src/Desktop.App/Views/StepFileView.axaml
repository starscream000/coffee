<!-- An editable step file: toolbar, bars for changes on disk and failed saves, the step list and the targets editor, and the text editor with problem lines marked. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:views="using:Desktop.App.Views"
             x:Class="Desktop.App.Views.StepFileView"
             x:DataType="vm:StepFileViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panelHeader">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space1}">
          <TextBlock Text="{Binding ProblemSummary}" Classes="small failed" VerticalAlignment="Center" Margin="{StaticResource InsetRight2}" />
          <Button Content="Rename" Classes="quiet" Command="{Binding RenameCommand}" />
          <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}" Margin="{StaticResource InsetRight2}" />
          <Button x:Name="RunButton" Content="Run" Command="{Binding RunCommand}" IsVisible="{Binding IsTest}" Margin="{StaticResource InsetRight2}"
                  ToolTip.Tip="Run this test (asks about unsaved changes first)." />
          <Button Content="Undo" Classes="quiet" Command="{Binding UndoCommand}" />
          <Button Content="Redo" Classes="quiet" Command="{Binding RedoCommand}" />
          <Button Content="Revert" Classes="quiet" Command="{Binding RevertCommand}" ToolTip.Tip="Put back the file as last read or saved" />
          <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" Classes="main" />
        </StackPanel>
        <TextBlock Text="{Binding File}" Classes="code small" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="notice warning" IsVisible="{Binding HasExternalChange}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Button Content="Reload from disk" Command="{Binding ReloadFromDiskCommand}" />
          <Button Content="Keep my version" Command="{Binding KeepMineCommand}" />
        </StackPanel>
        <TextBlock x:Name="ExternalChangeText" Text="The file changed on disk while you were editing it." VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="notice warning" IsVisible="{Binding IsDeletedOnDisk}">
      <TextBlock Text="The file was deleted on disk. Save to create it again." TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="notice failed" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" />
    </Border>
    <TextBlock DockPanel.Dock="Top" Margin="{StaticResource Inset3}" Text="{Binding LoadError}" Classes="failed" TextWrapping="Wrap"
               IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,Auto,*">
      <TabControl x:Name="SidePanel" Grid.Column="0" Width="{StaticResource SidePanelWidth}" Padding="0" IsVisible="{Binding HasSidePanel}" SelectedIndex="{Binding SidePanelIndex}">
        <TabItem Header="Steps" IsVisible="{Binding HasSteps}">
          <views:StepListView x:Name="StepList" DataContext="{Binding Steps}" />
        </TabItem>
        <TabItem Header="Targets" IsVisible="{Binding HasTargets}">
          <views:TargetsEditorView x:Name="TargetsEditor" DataContext="{Binding Targets}" />
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="{StaticResource SplitterSize}" IsVisible="{Binding HasSidePanel}" />
      <edit:TextEditor x:Name="Editor" Grid.Column="2"
                       Document="{Binding Document}"
                       ShowLineNumbers="True"
                       FontFamily="{StaticResource CodeFont}"
                       FontSize="{StaticResource TextBody}"
                       Padding="{StaticResource Inset1}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
    </Grid>
  </DockPanel>
</UserControl>
