<!--
  An editable step file: a header strip with the switch between its three views
  (Steps, Targets, Text; instruction D0004, task 9) and its file actions, bars
  for changes on disk and failed saves, and the view shown. The text view marks
  problem lines.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:views="using:Desktop.App.Views"
             x:Class="Desktop.App.Views.StepFileView"
             x:DataType="vm:StepFileViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panelHeader" Padding="{StaticResource InsetX2}">
      <DockPanel>
        <StackPanel x:Name="ViewSwitch" DockPanel.Dock="Left" Orientation="Horizontal" IsVisible="{Binding HasViews}">
          <Button x:Name="StepsViewButton" Classes="tab" Classes.selected="{Binding IsStepsShown}" Content="Steps"
                  Command="{Binding ShowStepsCommand}" IsVisible="{Binding HasSteps}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
          <Button x:Name="TargetsViewButton" Classes="tab" Classes.selected="{Binding IsTargetsShown}" Content="Targets"
                  Command="{Binding ShowTargetsCommand}" IsVisible="{Binding HasTargets}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
          <Button x:Name="TextViewButton" Classes="tab" Classes.selected="{Binding IsTextShown}" Content="Text"
                  Command="{Binding ShowTextCommand}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space1}" Margin="{StaticResource InsetY1}">
          <TextBlock Text="{Binding ProblemSummary}" Classes="small failed" VerticalAlignment="Center" Margin="{StaticResource InsetRight2}" />
          <Button Content="Undo" Classes="quiet" Command="{Binding UndoCommand}" />
          <Button Content="Redo" Classes="quiet" Command="{Binding RedoCommand}" />
          <Button x:Name="FileMenuButton" Classes="quiet" Content="File ▾" ToolTip.Tip="Revert, rename or delete this file.">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel x:Name="FileMenu" Spacing="{StaticResource Space1}" MinWidth="{StaticResource FieldMinWidth}">
                  <Button Classes="row" Content="Revert" Command="{Binding RevertCommand}" ToolTip.Tip="Put back the file as last read or saved" />
                  <Button Classes="row" Content="Rename…" Command="{Binding RenameCommand}" />
                  <Separator />
                  <Button Classes="danger" Content="Delete…" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="RunButton" Content="Run" Command="{Binding RunCommand}" IsVisible="{Binding IsTest}" Margin="{StaticResource InsetLeft2}"
                  ToolTip.Tip="Run this test (asks about unsaved changes first)." />
          <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" Classes="main" />
        </StackPanel>
        <TextBlock Text="{Binding File}" Classes="code small muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{StaticResource InsetX2}"
                   ToolTip.Tip="{Binding File}" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="notice warning" IsVisible="{Binding HasExternalChange}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space2}">
          <Button Content="Reload from disk" Command="{Binding ReloadFromDiskCommand}" />
          <Button Content="Keep my version" Command="{Binding KeepMineCommand}" />
        </StackPanel>
        <TextBlock x:Name="ExternalChangeText" Text="The file changed on disk while you were editing it." VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="notice warning" IsVisible="{Binding IsDeletedOnDisk}">
      <TextBlock Text="The file was deleted on disk. Save to create it again." TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="notice failed" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" />
    </Border>
    <TextBlock DockPanel.Dock="Top" Margin="{StaticResource Inset3}" Text="{Binding LoadError}" Classes="failed" TextWrapping="Wrap"
               IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Panel>
      <DockPanel IsVisible="{Binding IsStepsShown}">
        <!-- The test itself: selecting it shows its name, tags and skip reason in the details panel -->
        <Border x:Name="TestCard" DockPanel.Dock="Top" Classes="card step" Classes.selected="{Binding IsTestSelected}" Margin="{StaticResource InsetX3Y2}"
                IsVisible="{Binding HasTestSettings}">
          <Button x:Name="TestCardButton" Classes="row" Command="{Binding SelectTestCommand}" ToolTip.Tip="Edit the test's name, tags and skip reason">
            <StackPanel Spacing="{StaticResource Space1}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="test" Classes="label" Margin="{StaticResource InsetRight2}" VerticalAlignment="Center" />
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding TestSettings.TagList, FallbackValue={x:Null}}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="badge">
                        <TextBlock Classes="small" Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding TestSettings.Name, FallbackValue=''}" Classes="strong" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding TestSettings.Skip, StringFormat='Skipped: {0}', FallbackValue=''}" Classes="small warning" TextWrapping="Wrap"
                         IsVisible="{Binding TestSettings.IsSkipped, FallbackValue=False}" />
            </StackPanel>
          </Button>
        </Border>
        <views:StepListView x:Name="StepList" DataContext="{Binding Steps}" />
      </DockPanel>
      <Panel IsVisible="{Binding IsTargetsShown}">
        <views:TargetsEditorView x:Name="TargetsEditor" DataContext="{Binding Targets}" />
      </Panel>
      <edit:TextEditor x:Name="Editor"
                       IsVisible="{Binding IsTextShown}"
                       Document="{Binding Document}"
                       ShowLineNumbers="True"
                       FontFamily="{StaticResource CodeFont}"
                       FontSize="{StaticResource TextBody}"
                       Padding="{StaticResource Inset1}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
    </Panel>
  </DockPanel>
</UserControl>
