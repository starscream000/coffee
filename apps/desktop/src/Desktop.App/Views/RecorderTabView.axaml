<!-- The recorder's place: says that recording arrives with a later engine version and what it will do. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             x:Class="Desktop.App.Views.RecorderTabView"
             x:DataType="vm:RecorderTabViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock x:Name="RecorderHeading" Text="{x:Static vm:RecorderTabViewModel.Heading}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static vm:RecorderTabViewModel.Now}" TextWrapping="Wrap" />
      <TextBlock Text="What recording will do" Classes="heading" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{x:Static vm:RecorderTabViewModel.WillDo}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <DockPanel Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" />
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{x:Static vm:RecorderTabViewModel.Meanwhile}" TextWrapping="Wrap" Classes="muted" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
