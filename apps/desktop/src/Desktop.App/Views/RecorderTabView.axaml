<!-- The recorder's place: says that recording arrives with a later engine version and what it will do. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             x:Class="Desktop.App.Views.RecorderTabView"
             x:DataType="vm:RecorderTabViewModel">
  <ScrollViewer>
    <StackPanel Margin="{StaticResource Inset6}" Spacing="{StaticResource Space3}" MaxWidth="{StaticResource PageWidth}" HorizontalAlignment="Left">
      <TextBlock x:Name="RecorderHeading" Text="{x:Static vm:RecorderTabViewModel.Heading}" Classes="page" />
      <TextBlock Text="{x:Static vm:RecorderTabViewModel.Now}" TextWrapping="Wrap" />
      <TextBlock Text="What recording will do" Classes="title" Margin="{StaticResource InsetTop2}" />
      <ItemsControl ItemsSource="{x:Static vm:RecorderTabViewModel.WillDo}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <DockPanel Margin="{StaticResource InsetBottom1}">
              <TextBlock DockPanel.Dock="Left" Text="•" Margin="{StaticResource InsetRight2}" />
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{x:Static vm:RecorderTabViewModel.Meanwhile}" TextWrapping="Wrap" Classes="muted" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
