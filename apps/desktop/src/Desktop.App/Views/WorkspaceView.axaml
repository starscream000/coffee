<!--
  An open project, in named regions with a visible edge (instruction D0004,
  task 8): the project panel on the left, the tabs in the centre, the bottom
  panel (problems, runs, engine log) below, and the status bar. The splitters
  can be dragged; the bottom panel can be collapsed; the code-behind applies
  and reports the remembered sizes.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             xmlns:services="using:Desktop.App.Services"
             xmlns:views="using:Desktop.App.Views"
             xmlns:runs="using:Desktop.App.ViewModels.Runs"
             x:Class="Desktop.App.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:StepFileViewModel">
      <views:StepFileView />
    </DataTemplate>
    <DataTemplate DataType="vm:ActionCatalogViewModel">
      <views:ActionCatalogView />
    </DataTemplate>
    <DataTemplate DataType="runs:RunTabViewModel">
      <views:RunTabView />
    </DataTemplate>
    <DataTemplate DataType="vm:RecorderTabViewModel">
      <views:RecorderTabView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="statusBar">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="label" Text="{Binding LoginsText, StringFormat='Saved logins: {0}'}" VerticalAlignment="Center" />
        <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="{StaticResource BusyBarWidth}" Margin="{StaticResource InsetRight2}" IsVisible="{Binding IsBusy}" />
        <TextBlock x:Name="StatusText" Classes="small" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Notices of the project: why runs are not possible, the last run's notice, a file notice -->
    <Border DockPanel.Dock="Top" Classes="notice warning"
            IsVisible="{Binding Runs.UnavailableReason, Converter={x:Static ObjectConverters.IsNotNull}}">
      <SelectableTextBlock x:Name="RunUnavailable" Text="{Binding Runs.UnavailableReason}" TextWrapping="Wrap" VerticalAlignment="Center" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="notice"
            IsVisible="{Binding Runs.Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Dismiss" Classes="quiet" Command="{Binding Runs.DismissNoticeCommand}" />
        <SelectableTextBlock x:Name="RunNotice" Text="{Binding Runs.Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="notice"
            IsVisible="{Binding FileNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Dismiss" Classes="quiet" Command="{Binding DismissFileNoticeCommand}" />
        <SelectableTextBlock x:Name="FileNotice" Text="{Binding FileNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- The regions; the code-behind sets the sizes of the project, details and bottom tracks -->
    <Grid x:Name="Regions" Margin="{StaticResource Inset1}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource ColumnSide}" />
        <ColumnDefinition Width="{StaticResource SplitterLength}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="{StaticResource SplitterLength}" />
        <RowDefinition Height="{StaticResource BottomPanelLength}" />
      </Grid.RowDefinitions>

      <!-- PROJECT -->
      <Border x:Name="ProjectRegion" Grid.Column="0" Grid.Row="0" Classes="region">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panelHeader">
            <DockPanel>
              <Button x:Name="NewMenuButton" DockPanel.Dock="Right" Classes="quiet" Content="New ▾" ToolTip.Tip="Create a test, a flow or a targets file in the selected folder.">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel x:Name="NewMenu" Spacing="{StaticResource Space1}" MinWidth="{StaticResource FieldMinWidth}">
                      <Button x:Name="NewTestButton" Classes="row" Content="Test" Command="{Binding NewTestCommand}"
                              ToolTip.Tip="Create a test in the selected folder." />
                      <Button Classes="row" Content="Flow" Command="{Binding NewFlowCommand}" />
                      <Button Classes="row" Content="Targets file" Command="{Binding NewTargetsCommand}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <TextBlock DockPanel.Dock="Right" Classes="label" Text="{Binding Explorer.Summary}" VerticalAlignment="Center" Margin="{StaticResource InsetRight2}" />
              <TextBlock Classes="heading" Text="Project" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Inset2}" Spacing="{StaticResource Space2}">
            <TextBox x:Name="SearchBox" Text="{Binding Explorer.SearchText}" PlaceholderText="Search tests by name or path" />
            <ComboBox ItemsSource="{Binding Explorer.Tags}" SelectedItem="{Binding Explorer.SelectedTag}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Show only the tests with this tag." />
          </StackPanel>
          <TextBlock x:Name="ExplorerEmpty" DockPanel.Dock="Top" Text="{Binding Explorer.EmptyText}" Classes="muted" TextWrapping="Wrap" Margin="{StaticResource InsetX3Y2}"
                     IsVisible="{Binding Explorer.EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TreeView x:Name="ExplorerTree" ItemsSource="{Binding Explorer.Roots}" SelectedItem="{Binding Explorer.SelectedNode}">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:ExplorerNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:ExplorerNodeViewModel" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" ToolTip.Tip="{Binding Path}">
                  <TextBlock Text="•" Classes="muted" IsVisible="{Binding IsTest}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DisplayName}" Classes="strong" IsVisible="{Binding IsFolder}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DisplayName}" IsVisible="{Binding IsTest}" VerticalAlignment="Center" />
                  <Border Classes="badge error" IsVisible="{Binding HasErrors}" ToolTip.Tip="Errors">
                    <TextBlock Classes="small" Text="{Binding ErrorCount}" />
                  </Border>
                  <Border Classes="badge warning" IsVisible="{Binding HasWarningsOnly}" ToolTip.Tip="Warnings">
                    <TextBlock Classes="small" Text="{Binding WarningCount}" />
                  </Border>
                  <TextBlock Text="{Binding RowsText}" Classes="label" VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="badge">
                          <TextBlock Classes="small" Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter x:Name="ProjectSplitter" Grid.Column="1" Grid.Row="0" ResizeDirection="Columns" ToolTip.Tip="Drag to resize" />

      <!-- Tabs: step files, runs and the action catalogue -->
      <Border x:Name="TabsRegion" Grid.Column="2" Grid.Row="0" Classes="region">
        <TabControl x:Name="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" ToolTip.Tip="{Binding ToolTip}">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Button Content="×" Classes="quiet" VerticalAlignment="Center"
                        IsVisible="{Binding CanClose}" Command="{Binding CloseCommand}" ToolTip.Tip="Close" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
              <ContentControl Content="{Binding}" />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </Border>

      <GridSplitter x:Name="BottomSplitter" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" ResizeDirection="Rows" ToolTip.Tip="Drag to resize"
                    IsVisible="{Binding Layout.IsBottomOpen}" />

      <!-- Bottom panel: problems, runs, engine log -->
      <Border x:Name="BottomRegion" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Classes="region">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panelHeader" Padding="{StaticResource InsetX2}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="{StaticResource InsetY1}">
                <Button Classes="quiet" Content="Hide" Command="{Binding Layout.ToggleBottomCommand}" IsVisible="{Binding Layout.IsBottomOpen}"
                        ToolTip.Tip="Collapse the panel to this strip." />
                <Button x:Name="ShowBottomButton" Classes="quiet" Content="Show" Command="{Binding Layout.ToggleBottomCommand}" IsVisible="{Binding !Layout.IsBottomOpen}"
                        ToolTip.Tip="Open the panel again." />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ProblemsTab" Classes="tab" Classes.selected="{Binding Layout.IsProblemsShown}" Command="{Binding Layout.ShowProblemsCommand}"
                        VerticalAlignment="Stretch" VerticalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <TextBlock Text="Problems" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProblemSummary" Text="{Binding Problems.Summary}" Classes="label" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="RunsTab" Classes="tab" Classes.selected="{Binding Layout.IsRunsShown}" Command="{Binding Layout.ShowRunsCommand}"
                        VerticalAlignment="Stretch" VerticalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <TextBlock Text="Runs" VerticalAlignment="Center" />
                    <TextBlock x:Name="HistorySummary" Text="{Binding History.Summary}" Classes="label" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="EngineLogTab" Classes="tab" Classes.selected="{Binding Layout.IsEngineLogShown}" Command="{Binding Layout.ShowEngineLogCommand}"
                        Content="Engine log" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Panel IsVisible="{Binding Layout.IsBottomOpen}">
            <!-- Problems -->
            <DockPanel IsVisible="{Binding Layout.IsProblemsShown}">
              <CheckBox DockPanel.Dock="Top" Margin="{StaticResource InsetX2}" Content="Show warnings" IsChecked="{Binding Problems.ShowWarnings}" />
              <TextBlock x:Name="NoProblems" DockPanel.Dock="Top" Text="No problems. Every test file the engine checked is valid." Classes="muted" Margin="{StaticResource InsetX3Y2}"
                         IsVisible="{Binding !Problems.Items.Count}" />
              <ListBox x:Name="ProblemList" ItemsSource="{Binding Problems.Items}" SelectedItem="{Binding Problems.SelectedItem}" Grid.IsSharedSizeScope="True">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProblemItemViewModel">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProblemLocation" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Grid.Column="0" Classes="dot failed" Margin="{StaticResource InsetRight2}" IsVisible="{Binding IsError}" />
                      <Ellipse Grid.Column="0" Classes="dot warning" Margin="{StaticResource InsetRight2}" IsVisible="{Binding !IsError}" />
                      <StackPanel Grid.Column="1" Margin="{StaticResource InsetRight4}">
                        <TextBlock Text="{Binding Location}" Classes="code small" />
                        <TextBlock Text="{Binding Diagnostic.Code}" Classes="label" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- Runs -->
            <DockPanel IsVisible="{Binding Layout.IsRunsShown}">
              <DockPanel DockPanel.Dock="Top" Margin="{StaticResource InsetX2Y1}">
                <Button DockPanel.Dock="Right" Content="Refresh" Classes="quiet" Command="{Binding History.RefreshCommand}" />
                <TextBlock Text="{Binding History.Notice}" TextWrapping="Wrap" VerticalAlignment="Center"
                           IsVisible="{Binding History.Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </DockPanel>
              <TextBlock x:Name="NoRuns" DockPanel.Dock="Top" Text="No runs yet. Use Run in the top bar; every run is kept here." Classes="muted" Margin="{StaticResource InsetX3Y2}"
                         IsVisible="{Binding !History.Items.Count}" />
              <ScrollViewer>
                <ItemsControl x:Name="HistoryList" ItemsSource="{Binding History.Items}" Grid.IsSharedSizeScope="True">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="runs:RunHistoryItemViewModel">
                      <Button Classes="row"
                              ToolTip.Tip="{Binding RunId, StringFormat='Open run {0}'}"
                              Command="{Binding $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).History.OpenCommand}"
                              CommandParameter="{Binding}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource GlyphColumn}" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HistoryTime" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HistoryStatus" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HistoryEnv" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Glyph}" Classes="glyph" />
                          <TextBlock Grid.Column="1" Text="{Binding StartedText}" Classes="code small" Margin="{StaticResource InsetRight4}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding StatusText}" Margin="{StaticResource InsetRight4}" />
                          <TextBlock Grid.Column="3" Text="{Binding Environment}" Classes="muted" Margin="{StaticResource InsetRight4}" />
                          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{StaticResource Space3}">
                            <TextBlock Text="{Binding TotalsText}" Classes="small" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Problem}" Classes="small warning" VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>

            <!-- Engine log -->
            <ListBox x:Name="EngineLog" ItemsSource="{Binding EngineStatus.Log}" IsVisible="{Binding Layout.IsEngineLogShown}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="services:EngineLogLine">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Classes="muted code small" />
                    <TextBlock Text="{Binding Source}" Classes="muted code small" Width="{StaticResource BusyBarWidth}" />
                    <SelectableTextBlock Text="{Binding Text}" Classes="code small" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
