<!-- The settings panel: Node and engine paths. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.App.ViewModels"
             x:Class="Desktop.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Width="{StaticResource DialogWidth}">
  <Border Classes="dialog">
    <StackPanel Spacing="{StaticResource Space3}">
      <TextBlock Text="Settings" Classes="page" />
      <StackPanel Spacing="{StaticResource Space1}">
        <TextBlock Classes="heading" Text="Engine (dist/main.js)" />
        <TextBox Text="{Binding EnginePath}" PlaceholderText="Search automatically" />
        <TextBlock Text="{Binding EngineHelp}" Classes="label" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="{StaticResource Space1}">
        <TextBlock Classes="heading" Text="Node" />
        <TextBox Text="{Binding NodePath}" PlaceholderText="Search automatically" />
        <TextBlock Text="{Binding NodeHelp}" Classes="label" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" Classes="failed" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" HorizontalAlignment="Right">
        <Button Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Content="Save and restart engine" Classes="main" Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
