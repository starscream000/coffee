<!--
  The steps view of a test or flow file: step cards grouped under before, steps
  and after, each group with its own "Add step"; the action picker; and the
  actions on the selected card (move, duplicate, remove). The selected step's
  form is shown in the details panel (instruction D0004, task 9).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:steps="using:Desktop.App.ViewModels.Steps"
             x:Class="Desktop.App.Views.StepListView"
             x:DataType="steps:StepListViewModel">
  <DockPanel>
    <!-- Text only, with the reason -->
    <TextBlock x:Name="StepListProblem" DockPanel.Dock="Top" Margin="{StaticResource Inset3}" Text="{Binding Problem}" TextWrapping="Wrap"
               IsVisible="{Binding !IsAvailable}" />

    <!-- Action picker -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="{StaticResource Inset2}" IsVisible="{Binding IsPicking}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding PickerTitle}" Classes="heading" Margin="{StaticResource InsetBottom2}" />
        <DockPanel DockPanel.Dock="Top">
          <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelAddingCommand}" Margin="{StaticResource InsetLeft2}" />
          <TextBox x:Name="PickerSearch" Text="{Binding PickerSearch}" PlaceholderText="Search actions" />
        </DockPanel>
        <ScrollViewer MaxHeight="{StaticResource ListMaxHeight}" Margin="{StaticResource InsetTop2}">
          <ItemsControl x:Name="PickerList" ItemsSource="{Binding PickerItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="steps:StepActionChoice">
                <Button Classes="row" Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).AddCommand}" CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Classes="code" />
                    <TextBlock Text="{Binding Description}" Classes="label" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Sections and their step cards -->
    <ScrollViewer IsVisible="{Binding IsAvailable}">
      <ItemsControl x:Name="StepSections" ItemsSource="{Binding Sections}" Margin="{StaticResource InsetX3Y2}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="steps:StepSectionViewModel">
            <StackPanel Margin="{StaticResource InsetBottom2}">
              <DockPanel Margin="{StaticResource InsetY1}">
                <Button x:Name="AddStepButton" DockPanel.Dock="Right" Classes="quiet" Content="+ Add step"
                        Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).StartAddingCommand}" CommandParameter="{Binding Name}"
                        ToolTip.Tip="Add a step to this group: after the selected step when it is in this group, else at its end." />
                <TextBlock Text="{Binding Name}" Classes="section" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="No steps" Classes="label" Margin="{StaticResource InsetX2Y1}" IsVisible="{Binding IsEmpty}" />
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="steps:StepItemViewModel">
                    <Border Classes="card step" Classes.selected="{Binding IsSelected}" Margin="{StaticResource InsetBottom1}">
                      <StackPanel>
                        <Button Classes="row" ToolTip.Tip="{Binding LinesText}"
                                Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                          <DockPanel>
                            <Ellipse DockPanel.Dock="Right" Classes="dot failed" Margin="{StaticResource InsetLeft2}" IsVisible="{Binding HasError}" ToolTip.Tip="This step has errors" />
                            <Ellipse DockPanel.Dock="Right" Classes="dot warning" Margin="{StaticResource InsetLeft2}" IsVisible="{Binding HasWarningOnly}" ToolTip.Tip="This step has warnings" />
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" Classes="strong" IsVisible="{Binding HasName}" TextTrimming="CharacterEllipsis" />
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Action}" Classes="code accent" Margin="{StaticResource InsetRight2}" />
                                <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                            </StackPanel>
                          </DockPanel>
                        </Button>
                        <!-- The selected card's actions -->
                        <WrapPanel x:Name="StepActions" IsVisible="{Binding IsSelected}" Margin="{StaticResource InsetX1}"
                                   ItemSpacing="{StaticResource Space1}" LineSpacing="{StaticResource Space1}">
                          <Button Classes="quiet" Content="↑ Up" Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).MoveUpCommand}" />
                          <Button Classes="quiet" Content="↓ Down" Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).MoveDownCommand}" />
                          <Button Classes="quiet" Content="Duplicate" Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).DuplicateCommand}" />
                          <ItemsControl ItemsSource="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).MoveTargets}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="{StaticResource Space1}" LineSpacing="{StaticResource Space1}" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Button Classes="quiet" Content="{Binding StringFormat='Move to {0}'}"
                                        Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).MoveToSectionCommand}" CommandParameter="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Classes="danger" Content="Remove" Command="{Binding $parent[UserControl].((steps:StepListViewModel)DataContext).RemoveCommand}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
