<!-- The application: the dark theme, the design tokens and the one look of each control (ADR D0008). -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Desktop.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Desktop.App/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Fluent's own accent, so its controls (check boxes, focus, progress) use the token. -->
      <StaticResource x:Key="SystemAccentColor" ResourceKey="AccentColor" />
      <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="AccentPressedColor" />
      <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="AccentHoverColor" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Desktop.App/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
