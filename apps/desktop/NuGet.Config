<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for the desktop app: nuget.org only, so that restoring does
     not depend on the machine's own NuGet settings. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
